# Application
ENVIRONMENT=development
DEBUG=false

# React development server origins.
# Pydantic expects this list in JSON format.
FRONTEND_ORIGINS=["http://localhost:5173"]

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key

# Milestone 2 intentionally defaults to a transparent unavailable provider.
# Use deterministic_test only for local interactive testing; its output is
# conspicuously labelled test data and the app refuses it in production.
ROAD_ROUTING_PROVIDER=unavailable
