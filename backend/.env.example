# Application
ENVIRONMENT=development
DEBUG=false

# React development server origins.
# Pydantic expects this list in JSON format.
FRONTEND_ORIGINS=["http://localhost:5173"]

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=replace-with-your-supabase-key

# Google Routes API
GOOGLE_ROUTES_API_KEY=replace-with-your-google-routes-api-key