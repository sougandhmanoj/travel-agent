# Application
ENVIRONMENT=development
DEBUG=false

# React development server origins.
# Pydantic expects this list in JSON format.
FRONTEND_ORIGINS=["http://localhost:5173"]

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key

# Milestone 2 intentionally defaults to a transparent unavailable provider.
# Use deterministic_test only for local interactive testing; its output is
# conspicuously labelled test data and the app refuses it in production.
ROAD_ROUTING_PROVIDER=unavailable
# Set to osrm for real road-network geometry in local development.
OSRM_BASE_URL=https://router.project-osrm.org
MULTIMODAL_PROVIDER=google_routes

# Date-specific, licensed Rail itineraries through Google Maps Routes API.
# Requires Routes API billing and a server-restricted key; never expose this as VITE_*.
# MULTIMODAL_PROVIDER=google_routes
# GOOGLE_ROUTES_API_KEY=replace-with-server-only-google-maps-key
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
